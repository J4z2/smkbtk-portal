root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 4

# Portal page and assets keep the prototype's 2-space style (Prettier).
[{public/assets/*.{js,css},resources/portal/*.html}]
indent_size = 2
